
-- T1ST GIANT v3
-- Speed + STEAL NOW button (holds the "Steal" prompt using the hub's own hold/trigger method)
-- + USE POTION button (equips Giant Potion from backpack and uses it).
-- Nothing steals or drinks on inject. Only the buttons / keys (or the Auto toggle you switch on) do.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")

local player = Players.LocalPlayer
local env = (getgenv and getgenv()) or _G

if env.T1STGiantCleanup then
	pcall(env.T1STGiantCleanup)
end

----------------------------------------------------------------------
-- CONFIG
----------------------------------------------------------------------
local CONFIG = {
	PotionName = "Giant Potion",
	StealWord = "steal",       -- prompt ActionText must contain this
	HoldTime = 1.3,            -- server hold length for a steal
	PotionDelay = 0.1,         -- seconds into the hold before the potion is drunk
	Method = "hub",            -- "hub" = run the game's hold + trigger handlers (needs getconnections)
	                           -- "hold" = plain prompt hold (InputHoldBegin / InputHoldEnd)
	AutoCooldown = 0.2,        -- fallback path only (no getconnections): seconds between tries
	MinSpeed = 0,
	MaxSpeed = 60,
	DefaultSpeed = 16,
	MinRange = 5,
	MaxRange = 60,
	ToggleKey = Enum.KeyCode.RightShift, -- show / hide panel
	PotionKey = Enum.KeyCode.H,          -- same as the USE POTION button
}

----------------------------------------------------------------------
-- SETTINGS
----------------------------------------------------------------------
local FILE = "T1STGiant_v3.json"
local settings = {
	Speed = 30,
	SpeedEnabled = true,
	PotionWithSteal = true,
	AutoSteal = false,
	Range = 30,
}

local canFile = typeof(writefile) == "function" and typeof(readfile) == "function" and typeof(isfile) == "function"
if canFile then
	local ok, data = pcall(function()
		if isfile(FILE) then
			return HttpService:JSONDecode(readfile(FILE))
		end
	end)
	if ok and type(data) == "table" then
		for key, value in pairs(data) do
			if settings[key] ~= nil and typeof(value) == typeof(settings[key]) then
				settings[key] = value
			end
		end
	end
end
settings.Speed = math.clamp(math.floor(settings.Speed), CONFIG.MinSpeed, CONFIG.MaxSpeed)
settings.Range = math.clamp(math.floor(settings.Range), CONFIG.MinRange, CONFIG.MaxRange)
settings.AutoSteal = false -- never auto-start on inject

local saveQueued = false
local function save()
	if not canFile or saveQueued then
		return
	end
	saveQueued = true
	task.delay(0.5, function()
		saveQueued = false
		pcall(function()
			writefile(FILE, HttpService:JSONEncode(settings))
		end)
	end)
end

----------------------------------------------------------------------
-- LIFECYCLE
----------------------------------------------------------------------
local alive = true
local conns = {}
local gui
local currentHum
local speedConn

local function track(conn)
	conns[#conns + 1] = conn
	return conn
end

local function cleanup()
	if not alive then
		return
	end
	alive = false
	for _, conn in ipairs(conns) do
		pcall(function() conn:Disconnect() end)
	end
	table.clear(conns)
	if speedConn then
		pcall(function() speedConn:Disconnect() end)
		speedConn = nil
	end
	if currentHum and currentHum.Parent then
		currentHum.WalkSpeed = CONFIG.DefaultSpeed
	end
	if gui then
		gui:Destroy()
	end
	if env.T1STGiantCleanup == cleanup then
		env.T1STGiantCleanup = nil
	end
end
env.T1STGiantCleanup = cleanup

local setStatus = function() end
local setProgress = function() end

----------------------------------------------------------------------
-- SPEED
----------------------------------------------------------------------
local function applySpeed()
	if currentHum and currentHum.Parent and settings.SpeedEnabled then
		if currentHum.WalkSpeed ~= settings.Speed then
			currentHum.WalkSpeed = settings.Speed
		end
	end
end

local function bindHumanoid(hum)
	currentHum = hum
	if speedConn then
		speedConn:Disconnect()
	end
	speedConn = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(applySpeed)
	applySpeed()
end

local function onCharacter(char)
	local hum = char:WaitForChild("Humanoid", 10)
	if hum and alive then
		bindHumanoid(hum)
	end
end

track(player.CharacterAdded:Connect(onCharacter))
if player.Character then
	task.spawn(onCharacter, player.Character)
end

local function isCarrying()
	local v = player:GetAttribute("Stealing")
	return v ~= nil and v ~= false
end

----------------------------------------------------------------------
-- POTION (equip from backpack, then use)
----------------------------------------------------------------------
local function normalize(text)
	return (string.lower(text):gsub("[%s_%-]", ""))
end
local potionKey = normalize(CONFIG.PotionName)

local function findPotionIn(container)
	if not container then
		return nil
	end
	local exact = container:FindFirstChild(CONFIG.PotionName)
	if exact and exact:IsA("Tool") then
		return exact
	end
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("Tool") and string.find(normalize(child.Name), potionKey, 1, true) then
			return child
		end
	end
	return nil
end

local function getPotion()
	return findPotionIn(player.Character) or findPotionIn(player:FindFirstChildOfClass("Backpack"))
end

local potionBusy = false
local function drinkPotion()
	if potionBusy then
		return false
	end
	local char = player.Character
	local hum = currentHum
	local potion = getPotion()
	if not (char and hum and hum.Health > 0) then
		return false
	end
	if not potion then
		setStatus("no " .. CONFIG.PotionName .. " in inventory")
		return false
	end

	potionBusy = true
	local previous
	for _, child in ipairs(char:GetChildren()) do
		if child:IsA("Tool") and child ~= potion then
			previous = child
			break
		end
	end

	if potion.Parent ~= char then
		pcall(function() hum:EquipTool(potion) end)
		local waited = 0
		while potion.Parent ~= char and waited < 1 do
			waited += task.wait(0.05)
		end
	end

	local used = false
	if potion.Parent == char then
		used = pcall(function() potion:Activate() end)
		setStatus(used and (CONFIG.PotionName .. " used") or "activate failed")
	else
		setStatus("could not equip potion")
	end

	task.wait(0.3)
	if previous and previous.Parent and hum.Health > 0 and previous.Parent ~= char then
		pcall(function() hum:EquipTool(previous) end)
	end
	potionBusy = false
	return used
end

----------------------------------------------------------------------
-- STEAL PROMPTS
----------------------------------------------------------------------
local prompts = {}
local function register(inst)
	if inst:IsA("ProximityPrompt") then
		prompts[inst] = true
	end
end
track(workspace.DescendantAdded:Connect(register))
track(workspace.DescendantRemoving:Connect(function(inst)
	prompts[inst] = nil
end))
task.spawn(function()
	local count = 0
	for _, inst in ipairs(workspace:GetDescendants()) do
		if not alive then
			return
		end
		register(inst)
		count += 1
		if count % 1500 == 0 then
			task.wait()
		end
	end
end)

local function promptPosition(prompt)
	local parent = prompt.Parent
	if not parent then
		return nil
	end
	if parent:IsA("Attachment") then
		return parent.WorldPosition
	elseif parent:IsA("BasePart") then
		return parent.Position
	elseif parent:IsA("Model") then
		return parent:GetPivot().Position
	end
	local part = parent:FindFirstAncestorWhichIsA("BasePart")
	return part and part.Position or nil
end

local function isStealPrompt(prompt)
	return string.find(string.lower(prompt.ActionText), CONFIG.StealWord, 1, true) ~= nil
end

-- nearest enabled "Steal" prompt inside range
local function findStealPrompt()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then
		return nil
	end
	local best, bestDist = nil, math.huge
	for prompt in pairs(prompts) do
		if prompt.Parent and prompt.Enabled and isStealPrompt(prompt) then
			local pos = promptPosition(prompt)
			if pos then
				local dist = (pos - root.Position).Magnitude
				if dist <= settings.Range and dist < bestDist then
					best, bestDist = prompt, dist
				end
			end
		end
	end
	return best, bestDist
end

-- The game's own prompt handlers (same trick the hub uses).
-- hold   = what runs when you start holding the Steal button
-- trigger = what runs when the hold completes
local handlerCache = setmetatable({}, { __mode = "k" })
local function getHandlers(prompt)
	local cached = handlerCache[prompt]
	if cached and #cached.trigger > 0 then
		return cached
	end
	local h = { hold = {}, trigger = {} }
	if typeof(getconnections) == "function" then
		pcall(function()
			for _, c in ipairs(getconnections(prompt.PromptButtonHoldBegan)) do
				local f = c.Function
				if type(f) == "function" then
					local src = ""
					pcall(function() src = debug.info(f, "s") or "" end)
					-- PlotClient's own hold handler only greys out the other podiums, skip it
					if not (src:find("PlotClient", 1, true) and not src:find("AnimalPrompt", 1, true)) then
						h.hold[#h.hold + 1] = f
					end
				end
			end
			for _, c in ipairs(getconnections(prompt.Triggered)) do
				if type(c.Function) == "function" then
					h.trigger[#h.trigger + 1] = c.Function
				end
			end
		end)
	end
	handlerCache[prompt] = h
	return h
end

local busy = false
local function steal(prompt, withPotion)
	if busy or not prompt or not prompt.Parent then
		return false
	end
	busy = true

	local name = prompt.ObjectText ~= "" and prompt.ObjectText or "brainrot"
	setStatus("holding Steal: " .. name)
	pcall(function() prompt.RequiresLineOfSight = false end)

	local h = getHandlers(prompt)
	local useHub = CONFIG.Method == "hub" and #h.hold > 0 and #h.trigger > 0
	local need = math.max(prompt.HoldDuration, CONFIG.HoldTime)

	-- press and hold
	if useHub then
		for _, f in ipairs(h.hold) do
			task.spawn(pcall, f, player)
		end
	else
		pcall(function() prompt:InputHoldBegin() end)
	end

	local started = os.clock()
	local drank = false
	local aborted = false
	while os.clock() - started < need + 0.05 do
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local pos = prompt.Parent and promptPosition(prompt)
		if not alive or not root or not pos or (pos - root.Position).Magnitude > settings.Range + 15 then
			aborted = true
			break
		end
		setProgress(math.clamp((os.clock() - started) / need, 0, 1))
		if withPotion and not drank and os.clock() - started >= CONFIG.PotionDelay then
			drank = true
			task.spawn(drinkPotion)
		end
		if isCarrying() then
			break
		end
		task.wait()
	end

	-- release / finish
	if not aborted and not isCarrying() and prompt.Parent then
		if useHub then
			for _, f in ipairs(h.trigger) do
				task.spawn(pcall, f, player)
			end
		end
	end
	if not useHub then
		pcall(function() prompt:InputHoldEnd() end)
	end

	-- confirm via the game's Stealing flag
	local got = isCarrying()
	if not got and not aborted then
		local t0 = os.clock()
		while os.clock() - t0 < 1.2 do
			if isCarrying() then
				got = true
				break
			end
			task.wait(0.05)
		end
	end

	if got then
		setProgress(1)
		setStatus("stolen: " .. name)
		task.delay(1.2, function()
			if not busy then
				setProgress(0)
			end
		end)
	elseif aborted then
		setProgress(0)
		setStatus("steal cancelled (out of range)")
	else
		setProgress(0)
		setStatus("steal failed, try again")
	end
	busy = false
	return got
end

local function stealNow()
	if busy then
		return
	end
	if isCarrying() then
		setStatus("already carrying one")
		return
	end
	local prompt = findStealPrompt()
	if not prompt then
		setStatus("no Steal prompt within " .. settings.Range .. " studs")
		return
	end
	task.spawn(steal, prompt, settings.PotionWithSteal)
end

local function potionNow()
	task.spawn(drinkPotion)
end

----------------------------------------------------------------------
-- FAST AUTO STEAL (banked hold)
-- The server needs a 1.3s hold that began in range. So instead of starting the hold when you
-- arrive, a hold is kept "banked" while you are near a Steal prompt (re-begun before the server
-- drops it at ~2.6s). The moment you are inside range the grab fires, no waiting.
----------------------------------------------------------------------
local ARM_EXTRA, MAX_AGE = 10, 2.4
local stealList, stealListAt = {}, 0
local bankAt, bankPrompt = 0, nil
local lastFire, lastFallback = 0, 0
local potionDone = false
local wasCarrying = false

local function refreshStealList()
	table.clear(stealList)
	for prompt in pairs(prompts) do
		if prompt.Parent and isStealPrompt(prompt) then
			stealList[#stealList + 1] = prompt
		end
	end
end

track(RunService.Heartbeat:Connect(function()
	local now = os.clock()
	local carrying = isCarrying()
	if carrying ~= wasCarrying then
		wasCarrying = carrying
		if carrying then
			bankPrompt = nil
			setProgress(1)
			setStatus("stolen!")
			task.delay(1, function()
				if not isCarrying() then
					setProgress(0)
				end
			end)
		else
			potionDone = false
		end
	end

	if not settings.AutoSteal then
		bankPrompt = nil
		return
	end
	if carrying or busy then
		return
	end

	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	if now - stealListAt > 1 then
		stealListAt = now
		refreshStealList()
	end

	local range = settings.Range
	local target, targetDist = nil, math.huge
	local arm, armDist = nil, range + ARM_EXTRA
	for _, p in ipairs(stealList) do
		if p.Parent and p.Enabled then
			local pos = promptPosition(p)
			if pos then
				local d = (pos - root.Position).Magnitude
				if d <= armDist then
					arm, armDist = p, d
				end
				if d <= range and d < targetDist then
					target, targetDist = p, d
				end
			end
		end
	end

	if not arm then
		if bankPrompt then
			bankPrompt = nil
			setProgress(0)
		end
		return
	end

	local h = getHandlers(arm)
	if #h.hold == 0 or #h.trigger == 0 then
		-- no getconnections: plain prompt hold, retried quickly
		if target and now - lastFallback > CONFIG.AutoCooldown then
			lastFallback = now
			task.spawn(steal, target, settings.PotionWithSteal)
		end
		return
	end

	-- keep a hold banked so it is ripe on arrival
	local age = bankPrompt and (now - bankAt) or math.huge
	local eta = 0
	if not target then
		local pos = promptPosition(arm)
		local dir = pos and (pos - root.Position) or Vector3.zero
		local toward = dir.Magnitude > 0 and root.AssemblyLinearVelocity:Dot(dir.Unit) or 0
		eta = math.max(armDist - range, 0) / math.max(toward, 8)
	end
	if bankPrompt == nil or age + eta > MAX_AGE then
		pcall(function() arm.RequiresLineOfSight = false end)
		for _, f in ipairs(h.hold) do
			task.spawn(pcall, f, player)
		end
		bankAt, bankPrompt = now, arm
		age = 0
	end

	local need = math.max(arm.HoldDuration, CONFIG.HoldTime) + 0.03
	setProgress(math.min(age / need, 1))
	if not target then
		setStatus(string.format("approaching, hold banked (%.0f studs)", armDist))
		return
	end

	if settings.PotionWithSteal and not potionDone and age >= need * 0.5 then
		potionDone = true
		task.spawn(drinkPotion)
	end

	if age >= need and age <= MAX_AGE + 0.3 and now - lastFire >= 0.1 then
		lastFire = now
		local th = getHandlers(target)
		for _, f in ipairs(th.trigger) do
			task.spawn(pcall, f, player)
		end
		setStatus("grabbing " .. (target.ObjectText ~= "" and target.ObjectText or "brainrot"))
	end
end))


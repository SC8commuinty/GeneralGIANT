-- slider card: title row (+ optional number box) and a track
local function sliderCard(text, min, max, initial, onChange, withBox)
	local c = card(52)
	local l = label(c, text, 12, T.TEXT, Enum.Font.GothamBold)
	l.Size = UDim2.new(1, -90, 0, 20)
	l.Position = UDim2.fromOffset(12, 5)

	local box
	if withBox then
		box = Instance.new("TextBox")
		box.Size = UDim2.fromOffset(56, 20)
		box.Position = UDim2.new(1, -66, 0, 5)
		box.BackgroundColor3 = T.OFF_BG
		box.BorderSizePixel = 0
		box.TextColor3 = T.TEXT
		box.Font = Enum.Font.GothamBold
		box.TextSize = 12
		box.ClearTextOnFocus = false
		box.Text = tostring(initial)
		box.ZIndex = 3
		box.Parent = c
		corner(box, 7)
		stroke(box, T.STROKE, 1, 0.55)
	end

	local trackBar = Instance.new("Frame")
	trackBar.Size = UDim2.new(1, -24, 0, 10)
	trackBar.Position = UDim2.fromOffset(12, 34)
	trackBar.BackgroundColor3 = T.TRACK
	trackBar.BorderSizePixel = 0
	trackBar.ZIndex = 3
	trackBar.Parent = c
	corner(trackBar, 5)
	stroke(trackBar, T.STROKE, 1, 0.55)

	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	fill.BorderSizePixel = 0
	fill.ZIndex = 4
	fill.Parent = trackBar
	corner(fill, 5)
	gradient(fill, T.FILL1, T.FILL2, 0)

	local knob = Instance.new("Frame")
	knob.Size = UDim2.fromOffset(16, 16)
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.BackgroundColor3 = T.TEXT
	knob.BorderSizePixel = 0
	knob.ZIndex = 5
	knob.Parent = trackBar
	corner(knob, 8)
	stroke(knob, T.ACCENT, 2, 0.2)

	local function render(value)
		local alpha = (value - min) / (max - min)
		fill.Size = UDim2.new(alpha, 0, 1, 0)
		knob.Position = UDim2.new(alpha, 0, 0.5, 0)
	end
	render(initial)

	local hit = Instance.new("Frame")
	hit.Size = UDim2.new(1, 0, 0, 28)
	hit.Position = UDim2.fromOffset(0, 24)
	hit.BackgroundTransparency = 1
	hit.ZIndex = 6
	hit.Parent = c

	local dragging = false
	local function update(x)
		local width = trackBar.AbsoluteSize.X
		if width <= 0 then
			return
		end
		local alpha = math.clamp((x - trackBar.AbsolutePosition.X) / width, 0, 1)
		local value = math.floor(min + alpha * (max - min) + 0.5)
		render(value)
		onChange(value)
	end
	track(hit.InputBegan:Connect(function(i)
		if isPointer(i) then
			dragging = true
			body.ScrollingEnabled = false
			update(i.Position.X)
		end
	end))
	track(UIS.InputChanged:Connect(function(i)
		if dragging and isMove(i) then
			update(i.Position.X)
		end
	end))
	track(UIS.InputEnded:Connect(function(i)
		if dragging and isPointer(i) then
			dragging = false
			body.ScrollingEnabled = true
		end
	end))

	return { label = l, box = box, render = render }
end


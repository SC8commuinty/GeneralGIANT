setStatus = function(text)
	local low = string.lower(text)
	local color = T.TEXT
	if low:find("stolen", 1, true) or low:find("used", 1, true) or low:find("armed", 1, true) then
		color = T.GOOD
	elseif low:find("fail", 1, true) or low:find("cancel", 1, true) or low:find("no ", 1, true) or low:find("could not", 1, true) then
		color = T.BAD
	end
	if statusLabel and statusLabel.Parent then
		statusLabel.Text = text
		statusLabel.TextColor3 = color == T.TEXT and T.DIM or color
	end
	if barTitle and barTitle.Parent then
		barTitle.Text = text
		barTitle.TextColor3 = color
	end
end

